# Copy to .env and fill values. Never commit .env.

# Shared Bearer for /api/v1 writes and reads (0.1). Empty rejects all POSTs.
# Use the same value as MULTIMCP_INGEST_TOKEN when wrapping clients or the proxy.
INGEST_TOKEN=

# Client / proxy exporters (host processes; not required inside Compose containers)
# MULTIMCP_INGEST_URL=http://127.0.0.1:8000
# MULTIMCP_INGEST_TOKEN=

# Judge (optional until you enqueue evaluations)
JUDGE_BASE_URL=https://api.openai.com/v1
JUDGE_MODEL=
JUDGE_API_KEY=

# Local overrides (compose already sets these for containers)
# STORAGE_BACKEND=postgres
# EVAL_BACKEND=postgres
# DATABASE_URL=postgresql+asyncpg://multimcp:multimcp@localhost:5432/multimcp
# ALEMBIC_DATABASE_URL=postgresql+psycopg://multimcp:multimcp@localhost:5432/multimcp
