# Copy to .env (never commit .env).

OPENAI_API_KEY=

# Point at the multiMCP API (memory or Compose).
MULTIMCP_INGEST_URL=http://127.0.0.1:8000
MULTIMCP_INGEST_TOKEN=dev-token

# Chat model (must exist in your OpenAI account / multimcp price catalog when priced).
RAG_CHAT_MODEL=gpt-4.1-mini
RAG_EMBED_MODEL=text-embedding-3-small
