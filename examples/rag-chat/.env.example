# Optional local overrides. The app also reads the repo-root `.env`.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Falls back to root INGEST_TOKEN if unset.
MULTIMCP_INGEST_URL=http://127.0.0.1:8000
MULTIMCP_INGEST_TOKEN=dev-token

# Groq defaults (OpenAI-compatible). Override if you use real OpenAI.
RAG_CHAT_MODEL=openai/gpt-oss-20b
# lexical = no embeddings (works with Groq). embeddings = needs OpenAI embed API.
RAG_RETRIEVAL=lexical
RAG_EMBED_MODEL=text-embedding-3-small
